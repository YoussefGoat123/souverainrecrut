# ==========================================================
# Modèle de configuration du déploiement
# ==========================================================
# Copier en ".env" sur le serveur et remplacer les valeurs.
# Le vrai fichier .env n'est JAMAIS versionné : en CI/CD il est généré
# par GitLab à partir de variables masquées et protégées.

# ---------- Image Backend (publiée par Jenkins sur Docker Hub) ----------
BACKEND_IMAGE=jogoat123/souverainrecrut-backend
# Tag explicite et traçable : <version>-<commit>. Jamais "latest".
BACKEND_TAG=1.0.0-xxxxxxx

# ---------- PostgreSQL ----------
POSTGRES_USER=souverainrecrut
# Mot de passe fort, sans caractères spéciaux d'URL (@ : / ? #), car il est inséré dans DATABASE_URL.
# Exemple de génération : openssl rand -hex 24
POSTGRES_PASSWORD=CHANGER_MOI
POSTGRES_DB=souverainrecrut

# ---------- API ----------
# Secret de signature des JWT. Exemple de génération : openssl rand -hex 32
JWT_SECRET=CHANGER_MOI
API_VERSION=v1
API_PORT=4000
FRONTEND_URL=http://localhost:5173
